{
  "version": 1,
  "targets": {
    "win-x64": {
      "executable": "dotnet",
      "arguments": [
        "publish",
        "AppleMusicControl.csproj",
        "-c",
        "Release",
        "-f",
        "net10.0-windows10.0.19041.0",
        "-r",
        "win-x64",
        "--self-contained",
        "false",
        "-p:UseAppHost=false",
        "-o",
        "bin/publish/win-x64"
      ],
      "output": "bin/publish/win-x64"
    }
  }
}