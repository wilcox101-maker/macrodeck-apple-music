{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "com.wilcox101-maker.apple-music",
  "name": "Apple Music Control",
  "version": "1.0.0",
  "description": "Control the Apple Music app on Windows: transport, shuffle, repeat, system volume, now-playing variables and the Music Player widget.",
  "icon": "Assets/icon.svg",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/AppleMusicControl.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    }
  },
  "publisher": {
    "name": "wilcox101-maker"
  },
  "license": "MIT",
  "repository": "https://github.com/wilcox101-maker/macrodeck-apple-music",
  "homepage": "https://github.com/wilcox101-maker/macrodeck-apple-music",
  "compatibility": {
    "macroDeck": ">=3.0.0-0"
  },
  "permissions": [],
  "ai": {
    "interaction": false,
    "generatedContent": false,
    "generatedAssets": false
  }
}
